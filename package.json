{
  "name": "pr-lint-action",
  "version": "1.7.1",
  "description": "A GitHub Action to ensure that your PR title matches a given regex.",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "package": "ncc build src/index.ts --source-map --license licenses.txt",
    "lint:eslint": "eslint . --ext .ts",
    "lint:prettier": "prettier \"**/*.{ts,md,json,yml}\" --write",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/step-security/pr-lint-action.git"
  },
  "keywords": [
    "actions",
    "container",
    "github",
    "toolkit",
    "lint"
  ],
  "author": "step-security",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/step-security/pr-lint-action/issues"
  },
  "homepage": "https://github.com/step-security/pr-lint-action#readme",
  "dependencies": {
    "@actions/core": "2.0.3",
    "@actions/github": "9.1.1",
    "axios": "1.20.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "@vercel/ncc": "0.45.0",
    "eslint": "8.56.0",
    "eslint-config-prettier": "9.1.0",
    "jest": "29.7.0",
    "prettier": "3.2.5",
    "ts-jest": "29.1.2",
    "typescript": "5.3.3"
  },
  "packageManager": "yarn@4.18.0"
}
